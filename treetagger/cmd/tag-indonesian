#!/usr/bin/env bash
set -e

# ===============================
# Resolve script directory safely
# ===============================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

BIN_DIR="$ROOT_DIR/bin"
CMD_DIR="$ROOT_DIR/cmd"
LIB_DIR="$ROOT_DIR/lib"

# ===============================
# Argument parsing
# ===============================
USE_MWU=0
PASSTHRU_ARGS=()

for arg in "$@"; do
    if [[ "$arg" == "-mwu" ]]; then
        USE_MWU=1
    else
        PASSTHRU_ARGS+=("$arg")
    fi
done

# ===============================
# Pipelines
# ===============================
if [[ "$USE_MWU" -eq 1 ]]; then
    # Tokenize → Split clitics → MWU → Tag → Morph fix
    "$CMD_DIR/utf8-tokenize.perl" -a "$LIB_DIR/indonesian-abbreviations" "${PASSTHRU_ARGS[@]}" \
    | perl "$CMD_DIR/split-clitics.perl" \
    | perl "$CMD_DIR/mwl-lookup.perl" -f "$LIB_DIR/indonesian-mwls.txt" \
    | "$BIN_DIR/tree-tagger" "$LIB_DIR/indonesian.par" -token -lemma \
    | perl "$CMD_DIR/morph-fixer.perl"
else
    # Tokenize → Split clitics → Tag → Morph fix
    "$CMD_DIR/utf8-tokenize.perl" -a "$LIB_DIR/indonesian-abbreviations" "${PASSTHRU_ARGS[@]}" \
    | perl "$CMD_DIR/split-clitics.perl" \
    | "$BIN_DIR/tree-tagger" "$LIB_DIR/indonesian.par" -token -lemma \
    | perl "$CMD_DIR/morph-fixer.perl"
fi
